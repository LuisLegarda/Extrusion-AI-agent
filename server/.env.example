# Copia este archivo como .env y cambia los valores.

# Dirección del servidor: tu dominio (p. ej. monitor.miempresa.com) para HTTPS automático,
# o :80 para probar en la red interna sin dominio (sin cifrado: solo para pruebas).
SITE_ADDRESS=monitor.miempresa.com

# Contraseña de la base de datos (larga y aleatoria). Genera una con:  openssl rand -base64 30
DB_PASSWORD=cambia-esta-contraseña

# Clave para registrar líneas nuevas desde el monitor. Déjala vacía para desactivar el registro.
ENROLL_KEY=cambia-esta-clave-de-registro

# Días de historial (eventos y tendencias). Las capturas de problemas no se borran.
RETENTION_DAYS=365
